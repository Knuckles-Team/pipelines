# GENERATED at build time by `pipelines-connector render` from
# pipelines_hooks/connector/templates/compose.yml.tmpl. Never committed.
services:
  @@SERVICE@@:
    init: true
    user: "@@UID@@:@@UID@@"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 256
    mem_limit: @@MEMORY@@
    cpus: @@CPU@@
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=@@TMPFS_SIZE@@
    image: ${@@IMAGE_VAR@@:?set-@@IMAGE_VAR@@-to-image@sha256-digest}
@@CONTAINER_NAME@@@@HOSTNAME@@    restart: @@RESTART@@
@@VOLUMES@@@@ENV_FILE@@    environment:
      - PYTHONUNBUFFERED=1
      - HOST=0.0.0.0
      - PORT=@@PORT@@
      - TRANSPORT=streamable-http
@@COMPOSE_ENV@@    ports:
      - "@@PUBLISH_HOST@@:@@PUBLISH_PORT@@:@@PORT@@"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:@@PORT@@/health'@@HEALTH_COMMAND_TIMEOUT@@)"]
      interval: 30s
      timeout: @@HEALTH_TIMEOUT@@
      retries: 3
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

@@TOP_LEVEL_VOLUMES@@
