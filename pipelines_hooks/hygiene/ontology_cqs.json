{
 "questions": [
  {
   "id": "CQ-a",
   "question": "Who owns ServiceNow incidents, and where does that data come from?",
   "hops": [
    {
     "kind": "edge",
     "from": "Incident",
     "property": "affects",
     "to": "ConfigurationItem",
     "owner": "servicenow-api"
    },
    {
     "kind": "edge",
     "from": "ConfigurationItem",
     "property": "ownedBy",
     "to": "AssignmentGroup",
     "owner": "servicenow-api"
    },
    {
     "kind": "has_property",
     "class": "Incident",
     "property": [
      "sourceRecordRef",
      "wasDerivedFrom",
      "hadPrimarySource",
      "derivedFrom"
     ],
     "owner": "epistemic-graph"
    }
   ]
  },
  {
   "id": "CQ-b",
   "question": "Show open issues across GitHub, GitLab and Plane.",
   "hops": [
    {
     "kind": "shared_ancestor",
     "packs": {
      "github-agent": "Issue",
      "gitlab-api": "Issue",
      "plane-agent": "Issue"
     },
     "property": "state",
     "shared": "Issue"
    }
   ]
  },
  {
   "id": "CQ-c",
   "question": "Which prompts can act as a system prompt for incident triage?",
   "hops": [
    {
     "kind": "edge",
     "from": "Prompt",
     "property": "systemPromptFor",
     "to": "Task",
     "owner": "epistemic-graph"
    }
   ]
  },
